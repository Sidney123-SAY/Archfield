# Port HTTP
PORT=3000
# Adresse publique, utilisée dans les liens des e-mails envoyés aux clients
BASE_URL=https://archfield.example.com
# Dossier de la base SQLite et des photos (à mettre sur un disque persistant)
DATA_DIR=./data
# Envoi des rapports du lundi par e-mail (facultatif). Sans SMTP_URL, les rapports restent visibles sur le lien du client.
SMTP_URL=smtps://utilisateur:motdepasse@smtp.example.com:465
MAIL_FROM=Archfield <rapports@archfield.example.com>
# production : cookie de session « Secure » (HTTPS obligatoire)
NODE_ENV=production
# off : désactive l'envoi automatique des rapports (utile en développement)
REPORTS=on
# Derrière un proxy (Render, Railway, Fly.io) : 1, pour que les limites de requêtes voient la vraie adresse IP
TRUST_PROXY=1
# on : affiche les comptes de démo sur la page de connexion et le lien « chantier de démo » sur l'accueil
DEMO=off
