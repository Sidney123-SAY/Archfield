# Nom de domaine du site, pour le HTTPS automatique (compose.yaml). Ex. : archfield.duckdns.org
DOMAIN=archfield.example.com
# Port HTTP
PORT=3000
# Adresse publique, utilisée dans les liens des e-mails envoyés aux clients
BASE_URL=https://archfield.example.com
# Dossier de la base SQLite et des photos (à mettre sur un disque persistant)
DATA_DIR=./data
# --- E-mails : code de confirmation, mot de passe oublié, rapports du lundi (deploy/EMAIL.md) ---
# Sans SMTP_URL, rien ne part. Avec Brevo : smtp://IDENTIFIANT:CLE@smtp-relay.brevo.com:587
# (dans l'identifiant, le « @ » s'écrit %40 : 8a1b2c%40smtp-brevo.com). MAIL_FROM : un expéditeur validé chez Brevo.
SMTP_URL=
MAIL_FROM=
# Vérifier : npm run test-envoi -- vous@example.com
# Adresse de l'équipe Archfield : reçoit les demandes de visite de contrôle
CONTACT_EMAIL=
# production : cookie de session « Secure » (HTTPS obligatoire)
NODE_ENV=production
# off : désactive l'envoi automatique des rapports (utile en développement)
REPORTS=on
# Derrière un proxy (Render, Railway, Fly.io) : 1, pour que les limites de requêtes voient la vraie adresse IP
TRUST_PROXY=1
# on : boutons « Démo » sur la page de connexion et lien « chantier de démo » sur l'accueil (actifs par défaut hors production)
DEMO=off
# Connexion avec Google : identifiants OAuth créés sur https://console.cloud.google.com (voir README)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Connexion avec Apple (compte Apple Developer) : Services ID, identifiant d'équipe, clé « Sign in with Apple » (.p8, retours à la ligne remplacés par \n)
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# --- Téléphone : codes de confirmation par WhatsApp ou SMS (deploy/TELEPHONE.md) ---
# Vide : le code est écrit dans le journal du serveur (tests). SHOW_TEST_CODES=on l'affiche aussi à l'écran.
SMS_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SID=
# Canaux proposés, dans l'ordre : whatsapp,sms. Tant que WhatsApp n'est pas relié chez Twilio : sms
SMS_CHANNELS=sms
SHOW_TEST_CODES=
# Vérifier : npm run test-envoi -- +33612345678

# --- Abonnements par carte avec Stripe (deploy/PAIEMENT.md) ---
# Vide : paiement simulé hors production ; refusé en production sauf BILLING_TEST=on.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_TAX=
BILLING_TEST=
# Indication en FCFA à côté des prix en dollars (1 dollar = … FCFA).
USD_XOF=600

# --- Administration (/admin) : e-mails des administrateurs, ou npm run admin -- <e-mail ou téléphone> ---
ADMIN_EMAILS=
# Comptes de démonstration en un clic : seulement pour les captures et la recette automatique.
DEMO=off
