{
  "name": "archfield",
  "version": "0.1.0",
  "private": true,
  "description": "Suivi de chantier à distance : l'artisan publie, le client suit par un lien privé.",
  "main": "server/server.js",
  "scripts": {
    "start": "node --no-warnings server/server.js",
    "dev": "node --no-warnings --watch server/server.js",
    "seed": "node --no-warnings server/seed.js",
    "activate": "node --no-warnings server/activate.js",
    "screenshots": "node tools/screenshots.js",
    "icons": "node tools/icons.js",
    "qa": "node --no-warnings tools/qa.js",
    "parcours": "node --no-warnings tools/parcours.js",
    "test": "node --no-warnings --test test/*.test.js"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "bcryptjs": "2.4.3",
    "express": "4.22.3",
    "heic-convert": "2.1.0",
    "multer": "2.5.0",
    "nodemailer": "10.1.7",
    "qrcode-terminal": "0.12.0"
  },
  "devDependencies": {
    "playwright": "1.63.0"
  }
}
