{
  "name": "archfield",
  "version": "0.1.0",
  "private": true,
  "description": "Suivi de chantier à distance : l'artisan publie, le client suit par un lien privé.",
  "main": "server/server.js",
  "scripts": {
    "start": "node --no-warnings --env-file-if-exists=.env server/server.js",
    "dev": "node --no-warnings --env-file-if-exists=.env --watch server/server.js",
    "seed": "node --no-warnings --env-file-if-exists=.env server/seed.js",
    "activate": "node --no-warnings --env-file-if-exists=.env server/activate.js",
    "screenshots": "node tools/screenshots.js",
    "icons": "node tools/icons.js",
    "qa": "node --no-warnings tools/qa.js",
    "parcours": "node --no-warnings tools/parcours.js",
    "test": "node --no-warnings --test test/*.test.js",
    "admin": "node --no-warnings --env-file-if-exists=.env server/activate.js --admin",
    "purge-demo": "node --no-warnings --env-file-if-exists=.env server/purge-demo.js",
    "video": "node tools/video.js",
    "voix": "python3 tools/video/voix.py",
    "kit": "node tools/kit.js",
    "video:vertical": "node tools/video-vertical.js",
    "pub": "node tools/pub.js",
    "pub:son": "python3 tools/video/pub-son.py",
    "pub:storyboard": "STORYBOARD=1 node tools/pub.js",
    "guide": "node tools/guide.js"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "bcryptjs": "2.4.3",
    "express": "4.22.3",
    "heic-convert": "2.1.0",
    "multer": "2.5.0",
    "nodemailer": "10.1.7",
    "pdfkit": "0.17.2",
    "qrcode-terminal": "0.12.0"
  },
  "devDependencies": {
    "playwright": "1.63.0"
  }
}
